class library:

    def __init__(self):
        self.books = {}
        self.patrons = {}
        self.user = {}
        self.avaliable = True

    def add_book(self, book_id, title):
        self.books[book_id] = {"title": title, "avaliable": True}
        print("book is avaliable")

    def register_patrons(self, patron_id, patronname):
        self.patrons[patron_id] = {
            "patronname": patronname,
            "borrowed": []
        }
        print("patron registerd succesfully")

    def display_books(self, book_name, author):
        self.books[book_name] = {
            "author": author,
            "dispalyed": {}
        }
        print("book has been display succesfully")

    def borrow_book(self, book):
        if self.avaliable:
            self.avaliable = False
            print("book has been borrowed")
        else:
            print("book is not avaliable")

    def return_book(self, book):
        if self.avaliable:
            self.avaliable = True
        print("book has been returned")


library = library()

library.add_book("1", "The Great Gatsby")
